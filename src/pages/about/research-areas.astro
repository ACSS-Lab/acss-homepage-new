---
import HeroTabs from '../../components/layout/HeroTabs.astro';
import LangToggle from '../../components/layout/LangToggle.astro';
import PageHero from '../../components/layout/PageHero.astro';
import AreaDetail from '../../components/research/AreaDetail.astro';
import AreaPicker from '../../components/research/AreaPicker.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNavigation, getPage, getResearchAreas } from '../../lib/content';
import { sectionTabs } from '../../lib/navigation';

const [page, areas, nav] = await Promise.all([getPage('research-areas'), getResearchAreas(), getNavigation()]);
---

<BaseLayout title={page.title}>
  <PageHero title={page.hero.title} note={page.hero.note}>
    <HeroTabs slot="tabs" tabs={sectionTabs(nav, Astro.url.pathname)} />
  </PageHero>

  <div data-lang-scope="en" data-area-picker>
    <section class="container picker">
      <div class="heading">
        <h2 class="heading-title">
          <span data-lang="en">{page.heading.en}</span>
          <span data-lang="ko" lang="ko">{page.heading.ko}</span>
        </h2>
        <span class="hint">
          <span data-lang="en">{page.hint.en}</span>
          <span data-lang="ko" lang="ko">{page.hint.ko}</span>
        </span>
      </div>
      <AreaPicker areas={areas} imageNote={page.labels.imageNote} />
    </section>

    <section class="container detail" aria-live="polite">
      {areas.map((area, i) => <AreaDetail area={area} labels={page.labels} hidden={i !== 0} />)}
    </section>

    <LangToggle />
  </div>
</BaseLayout>

<style>
  .picker {
    padding-top: var(--space-16);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .heading-title {
    margin: 0;
    font: 600 var(--fs-h2) / 1.3 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hint {
    font: 400 var(--fs-sm) / 1.5 var(--font-sans);
    color: var(--gray-500);
  }

  .detail {
    padding-block: var(--space-12) var(--space-24);
  }
</style>
