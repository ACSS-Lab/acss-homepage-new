---
import HeroTabs from '../../components/layout/HeroTabs.astro';
import PageHero from '../../components/layout/PageHero.astro';
import PubRow from '../../components/publications/PubRow.astro';
import YearGroup from '../../components/publications/YearGroup.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAreaIndex, getNavigation, getPage, getPublications } from '../../lib/content';
import { sectionTabs } from '../../lib/navigation';

const [page, publications, nav, areas] = await Promise.all([getPage('publications'), getPublications(), getNavigation(), getAreaIndex()]);
const { list, labels } = page;

const accepted = publications.filter((p) => p.type === 'journal' || p.type === 'conference').length;
const preprints = publications.filter((p) => p.type === 'preprint').length;
const countLine = page.hero.countLine.replace('{accepted}', String(accepted)).replace('{preprints}', String(preprints));

const years = [...new Set(publications.map((p) => p.year))];
const perYear = (n: number) => list.perYear[n === 1 ? 0 : 1].replace('{n}', String(n));
---

<BaseLayout title={page.title}>
  <PageHero title={page.hero.title} note={page.hero.note}>
    <HeroTabs slot="tabs" tabs={sectionTabs(nav, Astro.url.pathname)} />
    <p class="count">{countLine}</p>
  </PageHero>

  <section class="container list">
    <div class="head">
      <h2 class="heading">{list.heading}</h2>
      <span class="footnote">{list.footnote}</span>
    </div>

    <div class="groups">
      {
        years.map((year, i) => {
          const items = publications.filter((p) => p.year === year);
          return (
            <YearGroup year={year} countLabel={perYear(items.length)} index={i}>
              {items.map((pub) => (
                <PubRow publication={pub} areas={areas} labels={labels} />
              ))}
            </YearGroup>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { initAccordion } from '../../scripts/accordion';
  initAccordion();
</script>

<style>
  .count {
    margin: 22px 0 0;
    font: 400 var(--fs-caption) / 1.5 var(--font-sans);
    color: var(--on-dark-muted);
    text-align: center;
  }

  .list {
    padding-block: var(--space-14) var(--space-24);
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .heading {
    flex: none;
    margin: 0;
    font: 600 var(--fs-h2) / 1.3 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .footnote {
    display: block;
    max-width: 600px;
    font: 400 var(--fs-caption) / 1.6 var(--font-sans);
    color: var(--gray-500);
    text-align: right;
  }

  .groups {
    margin-top: var(--space-6);
  }
</style>
