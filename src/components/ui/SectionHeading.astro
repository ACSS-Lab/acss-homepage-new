---
// Section title with a small square marker and a rule underneath.
interface Props {
  title: string;
  /** Small gray number after the title, e.g. how many items follow. */
  count?: number;
  /** Heading level; h3 for a heading inside a tab section. */
  as?: 'h2' | 'h3';
}

const { title, count, as: Tag = 'h2' } = Astro.props;
---

<div class="heading">
  <span class="marker"></span>
  <Tag class="title">{title}</Tag>
  {count !== undefined && <span class="count">{count}</span>}
</div>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--gray-300);
  }

  .marker {
    display: block;
    width: 8px;
    height: 8px;
    background: var(--gray-500);
  }

  .count {
    font: 400 var(--fs-caption) / 1.4 var(--font-sans);
    color: var(--gray-500);
  }

  .title {
    margin: 0;
    font: 600 var(--fs-h3) / 1.3 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
</style>
