---
// Section title with a small square marker and a rule underneath.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="heading">
  <span class="marker"></span>
  <h2 class="title">{title}</h2>
</div>

<style>
  .heading {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--gray-300);
  }

  .marker {
    display: block;
    width: 8px;
    height: 8px;
    background: var(--gray-500);
  }

  .title {
    margin: 0;
    font: 600 var(--fs-h3) / 1.3 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
</style>
