---
// Small status pill. `solid` is the strongest (navy fill), `accent` a navy tint;
// `neutral` and `muted` stay gray.
interface Props {
  tone?: 'solid' | 'accent' | 'neutral' | 'muted';
}

const { tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', tone]}><slot /></span>

<style>
  .badge {
    flex: none;
    padding: 5px 9px;
    border-radius: var(--radius-full);
    font: 500 var(--fs-caption) / 1.4 var(--font-sans);
    white-space: nowrap;
  }

  .solid {
    background: var(--navy-600);
    color: var(--white);
    font-weight: 600;
  }

  .accent {
    background: var(--navy-100);
    color: var(--navy-700);
  }

  .neutral {
    background: var(--gray-100);
    color: var(--gray-700);
  }

  .muted {
    background: var(--gray-100);
    color: var(--gray-500);
  }
</style>
