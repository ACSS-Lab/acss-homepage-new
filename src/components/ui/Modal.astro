---
// Modal window on the native <dialog>. Open it with a button carrying
// data-modal-open="<id>"; see scripts/modal.ts. The close button goes in the
// "close" area of the caller's content via data-modal-close.
interface Props {
  id: string;
  /** Accessible name of the window. */
  label: string;
  /** Clicking the dimmed backdrop closes the window. */
  backdropClose?: boolean;
  /** `fullscreen`: covers the viewport on a dark ground (photo viewer). */
  variant?: 'card' | 'fullscreen';
  /** Card width in px (card variant). */
  maxWidth?: number;
}

const { id, label, backdropClose = false, variant = 'card', maxWidth = 840 } = Astro.props;
---

<dialog class:list={['modal', variant]} id={id} aria-label={label} style={`--max-width: ${maxWidth}px`} data-backdrop-close={backdropClose ? '' : undefined}>
  <div class="card"><slot /></div>
</dialog>

<script>
  import { initModal } from '../../scripts/modal';
  initModal();
</script>

<style>
  .modal {
    width: 100%;
    max-width: var(--max-width);
    max-height: 88vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-lg);
    color: var(--ink);
  }

  .modal::backdrop {
    background: var(--overlay);
  }

  .modal[open] {
    animation: popIn 280ms var(--ease) both;
  }

  .modal[open]::backdrop {
    animation: fadeIn var(--dur) var(--ease) both;
  }

  .card {
    max-height: 88vh;
    overflow-y: auto;
  }

  .fullscreen {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    border-radius: 0;
    background: var(--overlay-dark);
    box-shadow: none;
  }

  .fullscreen::backdrop {
    background: transparent;
  }

  .fullscreen > .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    max-height: none;
    overflow: hidden;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes popIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal[open],
    .modal[open]::backdrop {
      animation: none;
    }
  }
</style>
