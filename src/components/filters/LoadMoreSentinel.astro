---
// Two skeleton cards at the end of a card list. When they scroll into view,
// scripts/facet-filter.ts reveals the next page; hidden once everything shows.
interface Props {
  /** How far below the viewport the next page starts loading. */
  rootMargin?: string;
  /** `cards`: two person-card skeletons. `rows`: a year gutter and one list row. */
  variant?: 'cards' | 'rows';
}

const { rootMargin = '200px 0px', variant = 'cards' } = Astro.props;
---

<div class:list={['sentinel', variant]} data-sentinel data-root-margin={rootMargin}>
  {
    variant === 'rows' && (
      <>
        <div class="gutter">
          <span class="line year" />
          <span class="line thin" style="--w: 52px" />
        </div>
        <div class="row">
          <span class="lines">
            <span class="line" style="--w: 38%" />
            <span class="line" style="--w: 74%" />
            <span class="line thin" style="--w: 46%" />
          </span>
          <span class="thumb" />
        </div>
      </>
    )
  }
  {
    variant === 'cards' &&
    [56, 48].map((w) => (
      <div class="skeleton">
        <span class="photo" />
        <span class="lines">
          <span class="line" style={`--w: ${w}%`} />
          <span class="line thin" style={`--w: ${w + 20}%`} />
          <span class="line thin" style={`--w: ${w + 10}%`} />
        </span>
      </div>
    ))
  }
</div>

<style>
  .sentinel {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 18px;
  }

  .skeleton {
    display: grid;
    grid-template-columns: 156px 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .photo {
    display: block;
    min-height: 203px;
    border-radius: var(--radius-xs);
    background: var(--gray-100);
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: var(--space-1);
  }

  .line {
    display: block;
    width: var(--w);
    height: 16px;
    background: var(--gray-100);
  }

  .thin {
    height: 11px;
  }

  /* rows variant */
  .rows {
    grid-template-columns: 104px minmax(0, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .gutter {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .year {
    --w: 72px;
    height: 26px;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 176px;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-3);
    border-top: 1px solid var(--gray-300);
  }

  .rows .lines {
    padding-top: 0;
  }

  .thumb {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    background: var(--gray-100);
  }
</style>
