---
// Two skeleton cards at the end of a card list. When they scroll into view,
// scripts/facet-filter.ts reveals the next page; hidden once everything shows.
interface Props {
  /** How far below the viewport the next page starts loading. */
  rootMargin?: string;
}

const { rootMargin = '200px 0px' } = Astro.props;
---

<div class="sentinel" data-sentinel data-root-margin={rootMargin}>
  {
    [56, 48].map((w) => (
      <div class="skeleton">
        <span class="photo" />
        <span class="lines">
          <span class="line" style={`--w: ${w}%`} />
          <span class="line thin" style={`--w: ${w + 20}%`} />
          <span class="line thin" style={`--w: ${w + 10}%`} />
        </span>
      </div>
    ))
  }
</div>

<style>
  .sentinel {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 18px;
  }

  .skeleton {
    display: grid;
    grid-template-columns: 156px 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .photo {
    display: block;
    min-height: 203px;
    border-radius: var(--radius-xs);
    background: var(--gray-100);
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: var(--space-1);
  }

  .line {
    display: block;
    width: var(--w);
    height: 16px;
    background: var(--gray-100);
  }

  .thin {
    height: 11px;
  }
</style>
