---
// Button that clears every filter. The small "All" form is navy while nothing
// is filtered and gray once something is; the large form sits in empty states.
import { getUi } from '../../lib/content';

interface Props {
  label?: string;
  variant?: 'small' | 'large';
}

const { label = (await getUi()).filter.reset, variant = 'small' } = Astro.props;
---

<button class:list={['reset', variant]} type="button" data-filter-reset data-state="clean">{label}</button>

<style>
  .reset {
    padding: 5px 12px;
    border: 0;
    background: var(--navy-600);
    font: 600 var(--fs-caption) / 1.3 var(--font-sans);
    color: var(--white);
    cursor: pointer;
  }

  .reset[data-state='dirty'] {
    background: var(--gray-100);
    color: var(--gray-500);
    font-weight: 500;
  }

  .reset[data-state='dirty']:hover {
    color: var(--ink);
  }

  .large,
  .large[data-state='dirty'] {
    min-height: 44px;
    margin-top: var(--space-4);
    padding: 0 var(--space-5);
    border-radius: var(--radius-md);
    background: var(--gray-100);
    font: 600 var(--fs-sm) / 1 var(--font-sans);
    color: var(--ink);
  }

  .large:hover,
  .large[data-state='dirty']:hover {
    background: var(--navy-100);
    color: var(--navy-700);
  }
</style>
