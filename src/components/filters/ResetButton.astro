---
// "All" button that clears every filter. Navy while nothing is filtered, gray once something is.
import { getUi } from '../../lib/content';

const label = (await getUi()).filter.reset;
---

<button class="reset" type="button" data-filter-reset data-state="clean">{label}</button>

<style>
  .reset {
    padding: 5px 12px;
    border: 0;
    background: var(--navy-600);
    font: 600 var(--fs-caption) / 1.3 var(--font-sans);
    color: var(--white);
    cursor: pointer;
  }

  .reset[data-state='dirty'] {
    background: var(--gray-100);
    color: var(--gray-500);
    font-weight: 500;
  }

  .reset[data-state='dirty']:hover {
    color: var(--ink);
  }
</style>
