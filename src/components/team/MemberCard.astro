---
// Card for a current member: join date, e-mail, research-interest chips and links.
import PersonCard from '../people/PersonCard.astro';
import AreaChip from '../ui/AreaChip.astro';
import type { Area, Member } from '../../lib/content';
import { formatMonthYear, isFutureMonth } from '../../lib/format';

interface Props {
  member: Member;
  areas: Map<string, Area>;
  labels: { representative: string; researchInterest: string; joined: string; incoming: string };
  index: number;
  /** Role label, part of what the search box matches. */
  roleLabel: string;
  hidden?: boolean;
}

const { member, areas, labels, index, roleLabel, hidden = false } = Astro.props;
const areaLabels = member.topics.map((code) => areas.get(code)?.label ?? code);
const haystack = [member.name, member.nameKo, member.email, roleLabel, ...areaLabels].filter(Boolean).join(' ').toLowerCase();
const date = formatMonthYear(member.joined);
const joinedLine = (isFutureMonth(member.joined) ? labels.incoming : labels.joined).replace('{date}', date);
---

<PersonCard
  class="rise"
  style={`--i: ${index}`}
  person={member}
  subtitle={member.nameKo}
  aside={joinedLine}
  hidden={hidden}
  data-item=""
  data-facet-role={member.role}
  data-facet-area={member.topics.join(' ')}
  data-search={haystack}
>
  {member.representative && <span class="rep" slot="badge">{labels.representative}</span>}
  <div class="interest">{labels.researchInterest}</div>
  <div class="chips">
    {member.topics.map((code) => <AreaChip area={areas.get(code)!} />)}
  </div>
</PersonCard>

<style>
  .rep {
    flex: none;
    padding: 3px 8px;
    background: var(--navy-100);
    font: 600 var(--fs-caption) / 1.3 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--navy-700);
  }

  .interest {
    margin-top: 14px;
    font: 500 var(--fs-caption) / 1.4 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: var(--space-2);
  }
</style>
