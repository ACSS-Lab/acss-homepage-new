---
// Long-form section: a label rail on the left, prose in the middle (capped at a
// readable line length), and a figure on the right.
---

<div class="row">
  <div class="label"><slot name="label" /></div>
  <div class="prose"><slot /></div>
  <div class="aside"><slot name="figure" /></div>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 268px;
    gap: var(--space-10);
    align-items: start;
    padding-top: var(--space-6);
    border-top: 1px solid var(--gray-300);
  }

  .label {
    font: 600 var(--fs-h3) / 1.4 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .prose {
    max-width: var(--container-narrow);
    font: 400 var(--fs-body) / var(--lh-prose-en) var(--font-sans);
    color: var(--ink);
  }

  .prose :global([lang='ko']) {
    line-height: var(--lh-prose-ko);
  }

  .prose :global(p) {
    margin: var(--space-5) 0 0;
    text-wrap: pretty;
  }

  .prose :global(p:first-child) {
    margin-top: 0;
  }

  .prose :global(strong) {
    font-weight: 600;
  }
  /* Tablet: label and prose share the left column, the figure sits beside them */
  @media (max-width: 1023px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 220px;
      grid-template-areas:
        'label figure'
        'prose figure';
      gap: var(--space-4) var(--space-8);
    }

    .label {
      grid-area: label;
    }

    .prose {
      grid-area: prose;
    }

    .aside {
      grid-area: figure;
    }
  }

  @media (max-width: 767px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'label'
        'prose'
        'figure';
      gap: var(--space-4);
    }

    .aside {
      max-width: 320px;
    }
  }
</style>
