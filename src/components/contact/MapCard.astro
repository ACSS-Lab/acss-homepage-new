---
// Map with provider pills (Google / Naver / Kakao). Google loads with the page;
// Kakao is built on first use by scripts/map.ts; Naver is a placeholder for now.
interface Props {
  google: { embedUrl: string };
  kakao: { timestamp: string; key: string };
  /** Frame title containing {provider}. */
  frameTitle: string;
  naverNote: string;
  class?: string;
  style?: string;
}

const { google, kakao, frameTitle, naverNote, class: className, ...rest } = Astro.props;
const title = (provider: string) => frameTitle.replace('{provider}', provider);
const providers = [
  { id: 'google', label: 'Google' },
  { id: 'naver', label: 'Naver' },
  { id: 'kakao', label: 'Kakao' },
];
---

<div class:list={['card', 'rise', className]} data-map {...rest}>
  <div class="layer" data-map-layer="google">
    <iframe src={google.embedUrl} title={title('Google')} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <div class="layer naver" data-map-layer="naver" hidden>
    <span class="note">{naverNote}</span>
  </div>
  <div class="layer" data-map-layer="kakao" data-kakao-timestamp={kakao.timestamp} data-kakao-key={kakao.key} data-kakao-title={title('Kakao')} hidden></div>

  <div class="tabs">
    {
      providers.map((provider, i) => (
        <button class="tab" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-map-tab={provider.id}>
          {provider.label}
        </button>
      ))
    }
  </div>
</div>

<script>
  import { initMap } from '../../scripts/map';
  initMap();
</script>

<style>
  .card {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  /* Covers the Google iframe and the Kakao iframe that the script inserts. */
  .layer :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .naver {
    display: flex;
    align-items: flex-end;
    padding: 14px;
    background: var(--ph);
  }

  .note {
    font: 500 var(--fs-caption) / 1.5 var(--font-mono);
    color: var(--gray-500);
    overflow-wrap: anywhere;
  }

  .tabs {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: flex;
    padding: 3px;
    border-radius: var(--radius-full);
    background: var(--white);
    box-shadow: var(--shadow-md);
  }

  .tab {
    padding: 6px 11px;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    font: 500 var(--fs-caption) / 1 var(--font-sans);
    color: var(--gray-500);
    cursor: pointer;
  }

  .tab:hover {
    color: var(--ink);
  }

  .tab[aria-pressed='true'] {
    background: var(--navy-600);
    color: var(--white);
    font-weight: 600;
  }
</style>
