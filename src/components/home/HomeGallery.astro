---
// Gallery preview: the newest posts as 16:9 slides with a caption chip, and a
// glass control pill (previous / next / progress dots / play-pause). Autoplays
// every `intervalMs`; starts paused under reduced motion.
import CarouselDots from '../ui/CarouselDots.astro';
import Figure from '../ui/Figure.astro';
import Icon from '../ui/Icon.astro';
import type { GalleryPost } from '../../lib/content';
import { link } from '../../lib/url';

interface Props {
  title: string;
  posts: GalleryPost[];
  more: { label: string; href: string };
  autoplay: boolean;
  intervalMs: number;
  labels: { coverNote: string; previous: string; next: string; toggle: string };
}

const { title, posts, more, autoplay, intervalMs, labels } = Astro.props;
const monthOf = (date: string) => date.slice(0, 7).replace('-', '.');
// Until a post has a cover, the caption says where its file should go (as in the draft).
const captionMeta = (post: GalleryPost) =>
  [post.cover ? undefined : labels.coverNote.replace('{path}', `/images/gallery/${post.id}/01.jpg`), post.tags[0], monthOf(post.date)].filter(Boolean).join(' · ');
---

<div class="gallery">
  <div class="head">
    <h2 class="title">{title}</h2>
    <a class="more" href={link(more.href)}>{more.label}<Icon name="arrow-right" size={13} /></a>
  </div>
  <div class="viewport" data-carousel data-loop style={`--autoplay-ms: ${intervalMs}ms`}>
    <div class="track">
      {
        posts.map((post) => (
          <div class="slide">
            <Figure class="cover" src={post.cover} alt="" />
            <div class="caption">
              <span class="caption-title">{post.title}</span>
              <span class="caption-meta">{captionMeta(post)}</span>
            </div>
          </div>
        ))
      }
    </div>
    <div class="controls">
      <button class="control" type="button" aria-label={labels.previous} data-carousel-prev>
        <Icon name="chevron-left" size={14} />
      </button>
      <button class="control next" type="button" aria-label={labels.next} data-carousel-next>
        <Icon name="chevron-right" size={14} />
      </button>
      <CarouselDots count={posts.length} fill={autoplay} variant="compact" />
      {
        autoplay && (
          <button class="control toggle" type="button" aria-label={labels.toggle} data-carousel-toggle>
            <span data-carousel-pause><Icon name="pause" size={12} /></span>
            <span data-carousel-play hidden><Icon name="play" size={12} /></span>
          </button>
        )
      }
    </div>
  </div>
</div>

<script>
  import { initCarousel } from '../../scripts/carousel';
  initCarousel();
</script>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .title {
    margin: 0;
    font: 600 var(--fs-h3) / 1.3 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font: 500 var(--fs-meta) / 1 var(--font-sans);
  }

  .viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .track {
    display: flex;
    width: 100%;
    height: 100%;
    transform: translateX(calc(var(--slide, 0) * -100%));
    transition: transform var(--dur-emph) var(--ease);
  }

  .slide {
    position: relative;
    flex: none;
    width: 100%;
    height: 100%;
  }

  .cover {
    width: 100%;
    height: 100%;
  }

  .caption {
    position: absolute;
    bottom: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 62%;
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    background: var(--glass);
    backdrop-filter: blur(4px);
  }

  .caption-title {
    font: 500 var(--fs-sm) / 1.4 var(--font-sans);
    color: var(--ink);
  }

  .caption-meta {
    margin-top: 2px;
    font: 400 var(--fs-caption) / 1.5 var(--font-sans);
    color: var(--gray-500);
  }

  .controls {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 8px;
    border-radius: var(--radius-full);
    background: var(--glass);
  }

  .control {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .control:hover {
    background: var(--ink-fill);
  }

  .next {
    margin-right: 2px;
  }

  .toggle {
    margin-left: 2px;
  }

  .toggle > span {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }
</style>
