---
// Card for one person: photo on the left; name, details and links on the right.
// Shared by the PI & Staffs and Team pages. Group-specific details go in the
// default slot; a badge next to the name goes in the "badge" slot.
import Eyebrow from '../ui/Eyebrow.astro';
import Figure from '../ui/Figure.astro';
import SocialLinks from './SocialLinks.astro';
import { getUi } from '../../lib/content';

interface Props {
  person: {
    id: string;
    name: string;
    photo?: string;
    email?: string;
    links?: { homepage?: string; linkedin?: string; scholar?: string };
  };
  /** `lg` is the featured layout used for the PI. */
  size?: 'md' | 'lg';
  /** Small uppercase label above the name (lg only). */
  eyebrow?: string;
  /** Gray line under the name, e.g. Korean name or title. */
  subtitle?: string;
  /** Short text at the top right, e.g. period or join date. */
  aside?: string;
  class?: string;
  /** Custom properties only, e.g. `--i` for the entrance stagger. */
  style?: string;
  hidden?: boolean;
  /** Data attributes for behavior scripts (filters, deep links). */
  [key: `data-${string}`]: string | undefined;
}

const { person, size = 'md', eyebrow, subtitle, aside, class: className, ...rest } = Astro.props;
const labels = (await getUi()).person;
const photoNote = labels.photoNote.replace('{path}', `/images/team/${person.id}.jpg`);
---

<article class:list={['card', size, className]} {...rest}>
  <Figure class="photo" src={person.photo} alt={person.name} note={photoNote} />
  <div class="body">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <div class="top">
      <span class="name-row">
        <span class="name">{person.name}</span>
        <slot name="badge" />
      </span>
      {aside && <span class="aside">{aside}</span>}
    </div>
    {subtitle && <div class="subtitle">{subtitle}</div>}
    {
      person.email && (
        <div class="email">
          {labels.email} : <a href={`mailto:${person.email}`}>{person.email}</a>
        </div>
      )
    }
    <slot />
    <div class="links">
      <SocialLinks links={person.links} />
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 156px 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .photo {
    align-self: stretch;
    min-height: 203px;
    border-radius: var(--radius-xs);
  }

  .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .name-row {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .name {
    font: 600 var(--fs-body) / 1.35 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .aside {
    flex: none;
    font: 400 var(--fs-caption) / 1.4 var(--font-sans);
    color: var(--gray-500);
  }

  .subtitle {
    margin-top: var(--space-1);
    font: 400 var(--fs-sm) / 1.5 var(--font-sans);
    color: var(--gray-500);
  }

  .email {
    margin-top: 10px;
    font: 400 var(--fs-meta) / 1.5 var(--font-sans);
    color: var(--gray-700);
  }

  /* Links sit at the bottom of the card however much detail is above them. */
  .links {
    margin-top: auto;
  }

  .links > :global(*) {
    padding-top: var(--space-4);
  }

  /* Featured layout (PI) */
  .lg {
    grid-template-columns: 228px minmax(0, 1fr);
    gap: var(--space-5);
    padding: var(--space-6);
  }

  .lg .photo {
    align-self: start;
    height: 280px;
    min-height: 0;
  }

  .lg .top {
    margin-top: 10px;
  }

  .lg .name {
    font: 700 var(--fs-title) / 1.25 var(--font-sans);
    letter-spacing: -0.025em;
  }

  .lg .email {
    margin-top: 14px;
  }

  .lg .links {
    margin-top: 0;
  }

  .lg .links > :global(*) {
    padding-top: var(--space-5);
  }
</style>
