---
// Gallery post card: 4:3 cover with a photo-count chip, title, date and tags.
// The whole card is a button that opens the post's photo viewer.
import Chip from '../ui/Chip.astro';
import Figure from '../ui/Figure.astro';
import type { GalleryPost } from '../../lib/content';
import { formatDate } from '../../lib/format';

interface Props {
  post: GalleryPost;
  labels: { photoCount: string; coverNote: string };
  showTags: boolean;
  index: number;
}

const { post, labels, showTags, index } = Astro.props;
const coverNote = labels.coverNote.replace('{path}', `/images/gallery/${post.id}/01.jpg`);
---

<button class="card rise" type="button" style={`--i: ${index}`} data-item data-filter={post.tags.join(' ')} data-modal-open={`gallery-${post.id}`}>
  <span class="cover-frame">
    <Figure class="cover" src={post.cover} alt="" note={coverNote} />
    <span class="count">{labels.photoCount.replace('{n}', String(post.photos.length))}</span>
  </span>
  <span class="title">{post.title}</span>
  <span class="date">{formatDate(post.date)}</span>
  {
    showTags && (
      <span class="tags">
        {post.tags.map((tag) => (
          <Chip>{tag}</Chip>
        ))}
      </span>
    )
  }
</button>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: transform var(--dur-slow) var(--ease);
  }

  .card:hover {
    transform: translateY(-3px);
  }

  .card:focus-visible {
    outline-offset: 3px;
  }

  .cover-frame {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--gray-100);
  }

  .cover {
    --figure-pad: 10px;
    aspect-ratio: 4 / 3;
    transition: transform var(--dur-emph) var(--ease);
  }

  .card:hover .cover {
    transform: scale(1.045);
  }

  .count {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: 5px 7px;
    border-radius: var(--radius-full);
    background: var(--glass);
    font: 500 var(--fs-caption) / 1 var(--font-sans);
    color: var(--gray-700);
  }

  .title {
    display: block;
    margin-top: var(--space-3);
    font: 600 var(--fs-body) / 1.45 var(--font-sans);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .date {
    display: block;
    margin-top: 5px;
    font: 400 var(--fs-caption) / 1.5 var(--font-sans);
    color: var(--gray-500);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 9px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .cover {
      transition: none;
    }
  }
</style>
