---
// Site footer — identical on every page. All text comes from site.yaml.
import { getSite } from '../../lib/content';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="row main">
    <div class="identity">
      <div class="name">{site.name}</div>
      {site.affiliation}
    </div>
    <a class="email" href={`mailto:${site.labEmail}`}>{site.labEmail}</a>
  </div>
  <div class="row legal">
    <span>© {year} {site.copyright}</span>
    {
      site.credit && (
        <a class="credit" href={site.credit.url} target="_blank" rel="noopener">
          {site.credit.label}
        </a>
      )
    }
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-12) var(--space-6) var(--space-8);
    background: var(--navy-900);
    color: var(--on-dark);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    max-width: var(--container);
    margin: 0 auto;
  }

  .main {
    align-items: flex-end;
    gap: var(--space-5);
    font: 400 var(--fs-meta) / 1.7 var(--font-sans);
  }

  .name {
    font: 600 var(--fs-sm) / 1.5 var(--font-sans);
    color: var(--white);
  }

  .email {
    color: var(--on-dark);
  }

  .email:hover {
    color: var(--white);
  }

  .legal {
    gap: var(--space-2);
    margin-top: 28px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--on-dark-rule);
    font: 400 var(--fs-caption) / 1.5 var(--font-sans);
    color: var(--on-dark-muted);
  }

  .credit {
    color: var(--on-dark-muted);
  }

  .credit:hover {
    color: var(--on-dark-strong);
  }
</style>
