---
// One top-level entry of the header menu: a plain link, or a link with a
// dropdown when the item has children. The dropdown opens on hover and on
// keyboard focus with CSS alone; scripts/nav.ts (loaded by SiteHeader) adds Escape
// and arrow keys.
import Icon from '../ui/Icon.astro';
import type { NavItem } from '../../lib/content';
import { isCurrentPage, link } from '../../lib/url';

interface Props {
  item: NavItem;
}

const { item } = Astro.props;
const { pathname } = Astro.url;
const children = item.children ?? [];
const isCurrent = isCurrentPage(item.href, pathname);
const isActive = isCurrent || children.some((child) => isCurrentPage(child.href, pathname));
---

{
  children.length === 0 ? (
    <a class:list={['link', { 'is-active': isActive }]} href={link(item.href)} aria-current={isCurrent ? 'page' : undefined}>
      {item.label}
    </a>
  ) : (
    <div class="item" data-nav-item>
      <a
        class:list={['link', { 'is-active': isActive }]}
        href={link(item.href)}
        aria-current={isCurrent ? 'page' : undefined}
        data-nav-trigger
      >
        {item.label}
        <Icon name="chevron-down" size={12} class="caret" />
      </a>
      <div class="menu" data-nav-menu>
        {children.map((child) => {
          const current = isCurrentPage(child.href, pathname);
          return (
            <a class:list={['menu-link', { 'is-active': current }]} href={link(child.href)} aria-current={current ? 'page' : undefined}>
              {child.label}
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  .item {
    position: relative;
  }

  .link {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 14px;
    border-radius: var(--radius-md);
    font: 500 var(--fs-ui) / 1 var(--font-sans);
    color: var(--gray-700);
  }

  .link:hover,
  .link:focus-visible {
    background: var(--gray-100);
    color: var(--ink);
  }

  .link.is-active {
    background: var(--navy-100);
    color: var(--navy-600);
    font-weight: 600;
  }

  /* The chevron only fills the middle of its 12px box; pull the empty sides in. */
  .caret {
    margin: 0 -2px;
    color: var(--gray-500);
  }

  .is-active > .caret {
    color: currentColor;
  }

  .menu {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: var(--z-dropdown);
    min-width: 196px;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-md);
  }

  /* Invisible bridge over the 4px gap so the pointer can travel from the link to the menu. */
  .menu::before {
    content: '';
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 4px;
  }

  .item:hover > .menu,
  .item:focus-within > .menu {
    display: block;
  }

  /* Closed with Escape; stays closed until the pointer or focus leaves the item. */
  .item[data-dismissed] > .menu {
    display: none;
  }

  .menu-link {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    font: 500 var(--fs-sm) / 1.2 var(--font-sans);
    color: var(--gray-700);
    white-space: nowrap;
  }

  .menu-link:hover,
  .menu-link:focus-visible {
    background: var(--gray-100);
    color: var(--navy-600);
  }

  .menu-link.is-active {
    background: var(--gray-100);
    color: var(--navy-600);
    font-weight: 600;
  }
</style>
