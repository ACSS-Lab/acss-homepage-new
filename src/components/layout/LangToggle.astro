---
// Floating EN/KR switch for bilingual pages. Place it inside the element that
// carries `data-lang-scope`; see scripts/lang-toggle.ts.
import { getUi } from '../../lib/content';

const labels = (await getUi()).language;
---

<div class="fab">
  <button class="toggle" type="button" aria-label={labels.label} data-lang-toggle>
    <span class="option en">{labels.en}</span>
    <span class="option ko">{labels.ko}</span>
  </button>
</div>

<script>
  import { initLangToggle } from '../../scripts/lang-toggle';
  initLangToggle();
</script>

<style>
  .fab {
    position: fixed;
    right: var(--space-6);
    bottom: var(--space-6);
    z-index: var(--z-fab);
  }

  .toggle {
    display: flex;
    padding: var(--space-1);
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-full);
    background: var(--white);
    box-shadow: var(--shadow-md);
    cursor: pointer;
  }

  .option {
    padding: 9px 14px;
    border-radius: var(--radius-full);
    font: 600 var(--fs-caption) / 1 var(--font-sans);
    color: var(--gray-500);
  }

  :global([data-lang-scope='en']) .en,
  :global([data-lang-scope='ko']) .ko {
    background: var(--navy-900);
    color: var(--white);
  }
</style>
