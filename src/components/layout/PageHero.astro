---
// Dark banner at the top of a page: striped navy background and a centered title.
//   slot "title"  replaces the default <h1> (e.g. an animated headline)
//   slot "tabs"   tab switcher under the title
//   default slot  further content below (used by the tall variant)
interface Props {
  /** Required unless the "title" slot is used. */
  title?: string;
  /** `tall`: more padding and a bottom-heavy scrim, for a hero that carries body text. */
  variant?: 'banner' | 'tall';
  /** Describes the planned background image; shown top-right until a real image exists. */
  note?: string;
}

const { title, variant = 'banner', note } = Astro.props;
---

<section class:list={['hero', variant]}>
  <div class="stripes"></div>
  {variant === 'tall' && <div class="scrim" />}
  {note && <div class="note">{note}</div>}
  <div class="container inner">
    <slot name="title">
      <h1 class="title">{title}</h1>
    </slot>
    {
      Astro.slots.has('tabs') && (
        <div class="tabs">
          <slot name="tabs" />
        </div>
      )
    }
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
  }

  .stripes,
  .scrim {
    position: absolute;
    inset: 0;
  }

  .stripes {
    background: var(--stripe-dark);
  }

  .scrim {
    background: var(--scrim-hero);
  }

  .note {
    position: absolute;
    top: var(--space-4);
    right: var(--space-6);
    font: 400 var(--fs-caption) / 1.5 var(--font-mono);
    color: var(--on-dark-muted);
    text-align: right;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .inner {
    position: relative;
    padding-block: 76px 60px;
  }

  .tall > .inner {
    padding-block: 88px 84px;
  }

  .title {
    margin: 0;
    font: 700 var(--fs-display) / 1.15 var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--white);
    text-align: center;
  }

  .tabs {
    display: flex;
    justify-content: center;
    margin-top: 26px;
  }
</style>
