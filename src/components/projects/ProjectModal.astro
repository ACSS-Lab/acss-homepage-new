---
// Detail window for one project: status, title, facts, overview and related papers.
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import Modal from '../ui/Modal.astro';
import { getUi, type Project } from '../../lib/content';
import { formatPeriod } from '../../lib/format';
import { publicationHref } from '../../lib/url';

interface Props {
  project: Project;
  statusLabel: string;
  labels: { agency: string; period: string; role: string; overview: string; related: string; relatedHint: string };
}

const { project, statusLabel, labels } = Astro.props;
const ui = await getUi();
---

<Modal id={`project-${project.id}`} label={project.title} backdropClose>
  <div class="body">
    <div class="head">
      <Badge tone={project.status === 'ongoing' ? 'solid' : 'neutral'}>{statusLabel}</Badge>
      <button class="close" type="button" aria-label={ui.modal.close} data-modal-close>
        <Icon name="x" size={18} />
      </button>
    </div>
    <h3 class="title">{project.title}</h3>

    <dl class="facts">
      <dt>{labels.agency}</dt>
      <dd class="strong">{project.agency}</dd>
      <dt>{labels.period}</dt>
      <dd class="period">{formatPeriod(project.start, project.end)}</dd>
      <dt>{labels.role}</dt>
      <dd>{project.role}</dd>
    </dl>

    <h4 class="section">{labels.overview}</h4>
    <p class="overview">{project.overview}</p>

    {
      project.papers.length > 0 && (
        <>
          <h4 class="section related">{labels.related}</h4>
          <div class="papers">
            {project.papers.map((paper) => (
              <a class="paper" href={publicationHref(paper.id)}>
                <span class="paper-body">
                  <span class="paper-meta">
                    <Badge>{ui.publicationTypes[paper.type]}</Badge>
                    <span class="venue">{paper.venue}</span>
                    <span class="year">{paper.year}</span>
                  </span>
                  <span class="paper-title">{paper.title}</span>
                </span>
                <Icon name="chevron-right" size={18} class="paper-arrow" />
              </a>
            ))}
          </div>
          <p class="hint">{labels.relatedHint}</p>
        </>
      )
    }
  </div>
</Modal>

<style>
  .body {
    padding: var(--space-6) var(--space-8) var(--space-8);
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .close {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: -6px -12px 0 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--gray-100);
    color: var(--gray-700);
    cursor: pointer;
  }

  .close:hover {
    background: var(--navy-100);
    color: var(--navy-700);
  }

  .title {
    margin: var(--space-3) 0 0;
    font: 600 var(--fs-h2) / 1.35 var(--font-sans);
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .facts {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--gray-100);
  }

  dt {
    font: 500 var(--fs-caption) / 1.6 var(--font-sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  dd {
    margin: 0;
    font: 400 var(--fs-sm) / 1.6 var(--font-sans);
    color: var(--gray-700);
  }

  .strong {
    font-weight: 500;
    color: var(--ink);
  }

  .period {
    font-variant-numeric: tabular-nums;
  }

  .section {
    margin: var(--space-6) 0 0;
    font: 600 var(--fs-sm) / 1.4 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  .section.related {
    margin-top: var(--space-8);
  }

  .overview {
    max-width: var(--container-narrow);
    margin: var(--space-3) 0 0;
    font: 400 var(--fs-ui) / 1.75 var(--font-sans);
    color: var(--gray-700);
    text-wrap: pretty;
  }

  .papers {
    margin-top: var(--space-3);
    border-top: 1px solid var(--gray-300);
  }

  .paper {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-bottom: 1px solid var(--gray-300);
    color: var(--ink);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .paper:hover {
    background: var(--navy-100);
  }

  .paper-body {
    flex: 1;
    min-width: 0;
  }

  .paper-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .venue {
    font: 500 var(--fs-meta) / 1.5 var(--font-sans);
    color: var(--gray-700);
  }

  .year {
    font: 400 var(--fs-meta) / 1.5 var(--font-sans);
    color: var(--gray-500);
  }

  .paper-title {
    display: block;
    margin-top: 5px;
    font: 600 var(--fs-ui) / 1.5 var(--font-sans);
    color: var(--ink);
    text-wrap: pretty;
  }

  .paper-arrow {
    flex: none;
    color: var(--navy-600);
  }

  .hint {
    margin: var(--space-3) 0 0;
    font: 400 var(--fs-caption) / 1.6 var(--font-sans);
    color: var(--gray-500);
  }
</style>
